POSTGRES_PASSWORD=replace-with-a-strong-password
DATABASE_URL=postgres://postgres:replace-with-a-strong-password@db:5432/portshare?sslmode=disable
PORTSHARE_ROOT_DOMAIN=portshare.kexoz.dev
# Browser origins allowed to call the API. The platform's own web origins
# (root, admin.<root>, api.<root>) are allowed automatically, so this only
# needs extras such as the local desktop dev server.
CORS_ORIGINS=https://portshare.kexoz.dev,https://admin.portshare.kexoz.dev

# ── Google OAuth (optional — enables the GAuth tunnel protection wall) ─────────
# Create credentials at https://console.cloud.google.com/apis/credentials
# The callback must be served by the Go API host (api.<root>), NOT the
# marketing site. Register this exact URI in Google Cloud Console:
#   https://api.<your-domain>/auth/google/callback
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_OAUTH_CALLBACK_URL=https://api.portshare.kexoz.dev/auth/google/callback

# Session signing secret — use a long random string (e.g. openssl rand -hex 32)
SESSION_SECRET=your-session-signing-secret

# ── Admin panel (admin.portshare.kexoz.dev) ───────────────────────────────────
# Comma-separated Google account emails allowed to access the admin panel.
ADMIN_EMAILS=jjagadesh980@gmail.com
