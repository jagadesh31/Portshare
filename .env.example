POSTGRES_PASSWORD=replace-with-a-strong-password
DATABASE_URL=postgres://postgres:replace-with-a-strong-password@db:5434/portshare?sslmode=disable
PORTSHARE_ROOT_DOMAIN=portshare.kexoz.dev
CORS_ORIGINS=https://portshare.kexoz.dev

# ── Google OAuth (optional — enables the GAuth tunnel protection wall) ─────────
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI must be: https://<your-domain>/auth/google/callback
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_OAUTH_CALLBACK_URL=https://portshare.kexoz.dev/auth/google/callback

# Session signing secret — use a long random string (e.g. openssl rand -hex 32)
SESSION_SECRET=your-session-signing-secret
